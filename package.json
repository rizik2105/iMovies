{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Online Movie Ticket Booking Platform (MERN Stack)",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"API,VITE\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "mern",
    "movie-booking",
    "ticket-reservation",
    "seat-locking",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Antigravity AI",
  "license": "ISC",
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "concurrently": "^9.1.2"
  }
}
